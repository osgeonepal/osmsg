[Unit]
Description=Prune osmsg caches (replication diffs + stale query cache)

[Service]
Type=oneshot
# Diffs are consumed once (resume state lives in DuckDB, not the filesystem), and DuckDB spill temp is
# transient, so a day's retention is ample.
ExecStart=/usr/bin/find /mnt/mnt/osmsg/cache -type f -mtime +1 -delete
# Query-cache files older than the monthly frontier cadence are never read again. The API creates this
# directory on its first cached query, so "-" keeps a fresh box (directory absent) from failing the unit.
ExecStart=-/usr/bin/find /mnt/mnt/osmsg/ducktmp/querycache -type f -mtime +40 -delete
